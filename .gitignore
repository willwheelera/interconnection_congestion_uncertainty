# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Data
# Sweep outputs only: everything here is regenerable from the tracked data/ inputs.
# Sweep INPUTS never live here -- select_relief_set writes its relief bus set to
# data/<case>_relief_set.json precisely so it stays tracked.
results/

# Virtual environments
.venv

# Docs output
docs/_build
docs/_static

# Code-generated or downloaded files
*pdf

# EGRET is fetched by uv from GitHub; no need to track locally
Egret/

notes/working_doc

# Slurm job logs. The directory itself is tracked because Slurm opens the --output
# file before the job script runs, so a fresh clone with no slurm/ fails to start.
slurm/*
!slurm/.gitkeep

# Editor swap files
*.swp

# Credentials
gridstatus_api_key.sh

# Fetched ERCOT datasets: re-downloadable via src/ercot/fetch_ercot.py
data/ercot/

# Bulk downloads: too large to track and re-fetchable from their source.
# texas_model/ercot_queue is NOT here -- it is the scraped ERCOT interconnection queue
# that the Texas queue builders read, and it is tracked.
texas_model/ACTIVSg2000/
data/Texas_EPIGRIDS/
data/pglib-uc-master/
data/*.zip
data/ercot_mora/
data/ercot_cdr/
